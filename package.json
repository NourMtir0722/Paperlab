{
  "name": "paperlab-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@paperlab/editor",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "knip": "knip",
    "test:parity": "node tools/parity.mjs",
    "shot": "node tools/stage-shot.mjs",
    "shot:ui": "node tools/editor-shot.mjs",
    "shot:play": "node tools/playground-shot.mjs",
    "perf": "node tools/stage-perf.mjs",
    "perf:field": "node tools/field-perf.mjs",
    "media": "node tools/media.mjs",
    "test:share": "node tools/share-loop-check.mjs",
    "test:drive": "node tools/stage-drive-check.mjs",
    "shot:light": "node tools/light-shot.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@changesets/cli": "^2.31.1",
    "knip": "^6.32.2",
    "playwright": "1.62.1",
    "turbo": "^2.10.11"
  }
}
