{
  "name": "paperlab",
  "version": "0.0.1",
  "description": "Physical, realistic paper as a React component. Sculptable sheets, preset-driven, geometry-true curl.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@react-three/fiber": ">=9",
    "gsap": ">=3.12",
    "react": ">=19",
    "three": ">=0.160"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@react-three/fiber": "^9.0.0",
    "@types/react": "^19.0.0",
    "gsap": "^3.12.0",
    "react": "^19.0.0",
    "three": "^0.172.0",
    "@types/three": "^0.172.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
