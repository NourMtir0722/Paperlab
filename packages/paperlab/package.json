{
  "name": "paperlab",
  "version": "0.2.0",
  "description": "Physical, realistic paper as a React component. Sculptable sheets, preset-driven, geometry-true curl.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./stage": {
      "import": {
        "types": "./dist/stage.d.ts",
        "default": "./dist/stage.js"
      },
      "require": {
        "types": "./dist/stage.d.cts",
        "default": "./dist/stage.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node ../../tools/sync-readme.mjs && tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:package": "publint && attw --pack ."
  },
  "peerDependencies": {
    "@react-three/fiber": ">=9",
    "gsap": ">=3.12",
    "react": ">=19",
    "three": ">=0.162",
    "@react-three/postprocessing": ">=3",
    "postprocessing": ">=6.36"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "three-custom-shader-material": "^6.4.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.5",
    "@types/react": "^19.0.0",
    "@types/three": "^0.185.1",
    "gsap": "^3.12.0",
    "postprocessing": "^6.36.0",
    "publint": "^0.3.22",
    "react": "^19.2.8",
    "three": "^0.185.1",
    "tsup": "^8.3.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "author": "Noor Mtir",
  "homepage": "https://github.com/NourMtir0722/Paperlab#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NourMtir0722/Paperlab.git",
    "directory": "packages/paperlab"
  },
  "bugs": "https://github.com/NourMtir0722/Paperlab/issues",
  "keywords": [
    "react",
    "three",
    "threejs",
    "react-three-fiber",
    "paper",
    "3d",
    "animation",
    "gallery",
    "webgl",
    "receipt",
    "page-curl",
    "cloth"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependenciesMeta": {
    "@react-three/postprocessing": {
      "optional": true
    },
    "postprocessing": {
      "optional": true
    }
  },
  "typesVersions": {
    "*": {
      "stage": [
        "./dist/stage.d.ts"
      ]
    }
  }
}
