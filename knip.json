{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["ffmpeg"],
  "workspaces": {
    ".": {},
    "packages/paperlab": {
      "project": "src/**"
    },
    "apps/playground": {
      "project": "src/**"
    },
    "apps/docs": {
      "project": "src/**"
    },
    "apps/editor": {
      "entry": [
        "src/harness/parity-main.ts",
        "src/harness/stage-main.tsx",
        "src/harness/media-main.tsx",
        "src/harness/field-main.tsx",
        "src/harness/hands-main.tsx"
      ],
      "project": "src/**"
    }
  }
}
